# Copy this file to .env and adjust as needed.

APP_NAME="House Price Prediction API"
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Path to the trained pipeline produced by the ML phase
# (src/train_model.py). Defaults to backend/models/house_price.pkl.
MODEL_PATH=models/house_price.pkl

# Path to the real locations exported during training
# (used only to report whether a submitted location was seen in training).
LOCATIONS_PATH=models/locations.json

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
